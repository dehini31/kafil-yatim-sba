# --- Admin server configuration (never commit the real .env) ---
PORT=8787
HOST=0.0.0.0
DATA_DIR=/data                       # persistent disk: admins, members, photos, PDFs (back it up)
PUBLISHER=github                     # "github" in production, "local" for development
PUBLIC_BASE_URL=https://dehini31.github.io/kafil-yatim-sba/
GITHUB_REPO=dehini31/kafil-yatim-sba
GITHUB_BRANCH=main
GITHUB_TOKEN=                        # fine-grained token, this repository only, Contents: read & write
ADMIN_URL=https://admin.example.org  # public URL of the admin server (enables Secure cookies when https)
