# --- Admin server configuration (never commit the real .env) ---
# Production: everything under https://dehini.com/kafil/ (self-hosted publisher, no GitHub needed)
PUBLISHER=local
BASE_PATH=/kafil
PUBLIC_BASE_URL=https://dehini.com/kafil/
ADMIN_URL=https://dehini.com/kafil/      # https => Secure cookies
TRUST_PROXY=true                         # only behind your own reverse proxy
PORT=8787
HOST=0.0.0.0
DATA_DIR=/data                           # persistent disk (back it up)
SITE_DIR=/data/site                      # the published public site

# Optional alternative: publish to GitHub Pages instead (PUBLISHER=github)
# GITHUB_REPO=dehini31/kafil-yatim-sba
# GITHUB_BRANCH=main
# GITHUB_TOKEN=                          # fine-grained, this repo only, Contents: read & write

# Alternative without VPS: admin on your own computer, site uploaded by FTP to the existing host
# PUBLISHER=ftp
# FTP_HOST=ftp.dehini.com
# FTP_USER=
# FTP_PASSWORD=
# FTP_REMOTE_DIR=/public_html/kafil
